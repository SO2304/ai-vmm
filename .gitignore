# Rust build output
/target

# Release bundle — regenerated by the build pipeline, not source
/dist

# Guest images — large binaries, downloaded or built locally, never committed.
# ai-vmm finds them via AI_VMM_KERNEL / AI_VMM_DISK or credentials.toml.
/vmlinux
*.ext4
*.img
*.iso

# Build scratch and stray artefacts
/.artifacts
/C:Userspc

# Internal business document — not part of the open-source distribution
/STRATEGY.md

# Launch-day technical article — published externally (blog / dev.to / HN),
# kept out of the repo to avoid a duplicate of the README's narrative.
/WRITEUP.md

# Stray verification logs from local verification scripts (smp_boot.log, etc.).
*.log

# Editor / OS noise
*.swp
.DS_Store

# Note: Cargo.lock IS committed — ai-vmm ships as a binary, so a pinned,
# reproducible dependency graph is intentional.
